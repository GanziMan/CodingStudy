# [필수] Anthropic API 키 (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
# 기본값: claude-sonnet-5-5
ANTHROPIC_MODEL=

# DB: 비워두면 로컬 파일(file:./data/app.db). 배포 시 Turso 주소와 토큰
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# [배포] 사이트 주소 (예: https://codetest-lab.vercel.app) — canonical·sitemap·OG에 사용
SITE_URL=

# [선택] 검색엔진 소유 확인 코드 (meta 태그 content 값만)
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# [선택] AI 일일 사용 한도 (기본: IP당 30회/전체 1000회, 문제 생성 IP당 3개/전체 50개)
AI_DAILY_LIMIT_PER_IP=
AI_DAILY_LIMIT_GLOBAL=
GENERATE_DAILY_LIMIT_PER_IP=
GENERATE_DAILY_LIMIT_GLOBAL=

# [선택] 관리자 문제 삭제용 토큰 (DELETE /api/problems/:id 에 x-admin-token 헤더)
ADMIN_TOKEN=

# [로그인] Auth.js — AUTH_SECRET은 `npx auth secret` 또는 `openssl rand -base64 32`로 생성
AUTH_SECRET=
# 카카오 (developers.kakao.com) — Redirect URI: https://<도메인>/api/auth/callback/kakao
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
# 구글 (console.cloud.google.com) — Redirect URI: https://<도메인>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
